---
import { Image } from 'astro:assets';
import { apps } from '../data/apps';

const title = 'Apps · Manuel Gallego';
const description = 'Aplicaciones que estoy desarrollando: descargas, webs y código fuente.';
---

<html lang="es">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="description" content={description} />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<title>{title}</title>
	</head>
	<body>
		<main>
			<header>
				<h1>Mis aplicaciones</h1>
				<p>{description}</p>
			</header>

			<ul class="grid">
				{
					apps.map((app) => (
						<li class="card">
							<div class="cover">
								{app.screenshot ? (
									<Image loading="eager" src={app.screenshot} alt={`Captura de ${app.name}`} widths={[400, 800]} sizes="(max-width: 640px) 100vw, 320px" />
								) : app.icon ? (
									<Image loading="eager" src={app.icon} alt="" class="cover-icon" width={112} height={112} />
								) : (
									<span class="cover-letter" aria-hidden="true">{app.name[0]}</span>
								)}
							</div>
							<div class="title">
								{app.icon ? (
									<Image loading="eager" src={app.icon} alt="" class="icon" width={40} height={40} />
								) : (
									<span class="icon icon-letter" aria-hidden="true">{app.name[0]}</span>
								)}
								<div>
									<h2>{app.name}</h2>
									<p class="meta">
										{[...app.platforms, app.tech].filter(Boolean).join(' · ')}
									</p>
								</div>
							</div>
							<p class="desc">{app.description}</p>
							{app.status && <p class="status">{app.status}</p>}
							<div class="actions">
								{app.primary && (
									<a class="btn primary" href={app.primary.href} target="_blank" rel="noopener">
										{app.primary.label}
									</a>
								)}
								<a class="btn" href={app.repo} target="_blank" rel="noopener">
									Repositorio
								</a>
							</div>
						</li>
					))
				}
			</ul>

			<footer>
				<a href="https://github.com/gallegomanuel8" target="_blank" rel="noopener">github.com/gallegomanuel8</a>
			</footer>
		</main>
	</body>
</html>

<style is:global>
	:root {
		--bg: #fafafa;
		--fg: #18181b;
		--muted: #71717a;
		--card: #ffffff;
		--border: #e4e4e7;
		--cover: #f4f4f5;
		--accent: #2563eb;
		--accent-fg: #ffffff;
		color-scheme: light dark;
	}
	@media (prefers-color-scheme: dark) {
		:root {
			--bg: #09090b;
			--fg: #fafafa;
			--muted: #a1a1aa;
			--card: #18181b;
			--border: #27272a;
			--cover: #111113;
			--accent: #3b82f6;
		}
	}
	* {
		box-sizing: border-box;
	}
	body {
		margin: 0;
		background: var(--bg);
		color: var(--fg);
		font: 16px/1.5 system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif;
	}
	main {
		max-width: 960px;
		margin: 0 auto;
		padding: 48px 16px;
	}
	header h1 {
		margin: 0 0 4px;
		font-size: 2rem;
	}
	header p {
		margin: 0 0 32px;
		color: var(--muted);
	}
	.grid {
		list-style: none;
		padding: 0;
		margin: 0;
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
		gap: 16px;
	}
	.card {
		display: flex;
		flex-direction: column;
		overflow: hidden;
		padding: 0 20px 20px;
		background: var(--card);
		border: 1px solid var(--border);
		border-radius: 12px;
	}
	.card h2 {
		margin: 0;
		font-size: 1.25rem;
	}
	.cover {
		aspect-ratio: 16 / 10;
		margin: 0 -20px 16px;
		display: grid;
		place-items: center;
		background: var(--cover);
		border-bottom: 1px solid var(--border);
		overflow: hidden;
	}
	.cover img:not(.cover-icon) {
		width: 100%;
		height: 100%;
		object-fit: cover;
		object-position: top left;
	}
	.cover-icon {
		width: 112px;
		height: 112px;
		filter: drop-shadow(0 6px 16px rgb(0 0 0 / 0.25));
	}
	.cover-letter {
		font-size: 4rem;
		font-weight: 700;
		color: var(--muted);
	}
	.title {
		display: flex;
		align-items: center;
		gap: 12px;
		margin-bottom: 12px;
	}
	.icon {
		width: 40px;
		height: 40px;
		flex: none;
		border-radius: 10px;
	}
	.icon-letter {
		display: grid;
		place-items: center;
		background: var(--cover);
		border: 1px solid var(--border);
		font-weight: 700;
		color: var(--muted);
	}
	.meta {
		margin: 0;
		font-size: 0.85rem;
		color: var(--muted);
	}
	.desc {
		margin: 0 0 12px;
		flex: 1;
	}
	.status {
		margin: 0 0 12px;
		font-size: 0.85rem;
		color: var(--muted);
		font-style: italic;
	}
	.actions {
		display: flex;
		gap: 8px;
		flex-wrap: wrap;
	}
	.btn {
		padding: 8px 14px;
		border: 1px solid var(--border);
		border-radius: 8px;
		color: var(--fg);
		text-decoration: none;
		font-size: 0.9rem;
		font-weight: 500;
	}
	.btn:hover {
		border-color: var(--muted);
	}
	.btn.primary {
		background: var(--accent);
		border-color: var(--accent);
		color: var(--accent-fg);
	}
	.btn.primary:hover {
		filter: brightness(1.1);
	}
	footer {
		margin-top: 48px;
		font-size: 0.9rem;
	}
	footer a {
		color: var(--muted);
	}
</style>
